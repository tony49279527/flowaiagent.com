# Discovery Backend Configuration

# --- AI API Configuration ---
# Your OpenAI API Key (required for report generation)
OPENAI_API_KEY=sk-xxxx...
# Model to use (gpt-4o, gpt-4-turbo, etc.)
OPENAI_MODEL=gpt-4o

# --- SMTP Configuration (Email Sending) ---
# For Gmail: smtp.gmail.com
SMTP_SERVER=smtp.gmail.com
# For Gmail: 587
SMTP_PORT=587
# Your email address
SMTP_USER=your-email@example.com
# Use an App Password if using Gmail with 2FA
SMTP_PASSWORD=your-app-password
# The email address that appears as the sender (usually same as SMTP_USER)
SENDER_EMAIL=your-email@example.com

# --- Server Configuration ---
# Port for the discovery server (default: 8081)
DISCOVERY_PORT=8081
